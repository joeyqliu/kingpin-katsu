---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import KickstarterBlock from '../components/KickstarterBlock.astro';
import PopupsBlock from '../components/PopupsBlock.astro';
import Marquee from '../components/Marquee.astro';
import Dish from '../components/Dish.astro';
import ContactLinks from '../components/ContactLinks.astro';
import badge from '../assets/brand/badge.png';
import heroBento from '../assets/food/chicken-katsu-bento.jpg';
import teamSelfie from '../assets/events/team-selfie.jpg';
import { eventImage } from '../lib/images';
import { site, menu } from '../lib/data';
import { url } from '../lib/url';

const katsu = menu.sections[0]!.items;
const highlights = katsu.filter((i) => ['Katsu Curry', 'Katsu Sando', 'Katsu Burger', 'Katsu Nuggets'].includes(i.name));
const strip = [
  { img: 'booth-crowd', cap: 'Lines at 365 Night Market', tilt: -4 },
  { img: 'flag-swing', cap: 'Flag game: strong', tilt: 3 },
  { img: 'night-queue', cap: 'After dark at the booth', tilt: -2 },
];
const igSquares = [
  { img: 'burger-hand', alt: 'A crew member holding up a katsu burger' },
  { img: 'bento-thumbs', alt: 'Thumbs up with a fresh katsu bento' },
  { img: 'faction-team', alt: 'The team at Faction Brewing' },
  { img: 'kitchen-prep', alt: 'Prepping sides by hand in the kitchen' },
];
---

<Base
  title="Kingpin Katsu"
  description="Crispy, juicy Japanese katsu made fresh to order. Bay Area pop-ups, catering, and our first restaurant coming soon. Back our Kickstarter!"
  legacyRedirect
>
  <!-- HERO -->
  <section class="hero panko">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow">Bay Area pop-ups · Restaurant coming soon</span>
        <h1>The new <span class="hero__boss">boss</span> of katsu is in town!</h1>
        <p class="hero__lede">
          Crispy, juicy Japanese katsu, dry-brined overnight and fried fresh to order. Chicken, pork, or tofu. Your call.
        </p>
        <div class="btn-row">
          <a class="btn" href={url('popups')}>Where's the next pop-up?</a>
          <a class="btn btn--ink" href={url('menu')}>See the menu</a>
        </div>
      </div>

      <div class="hero__art">
        <Picture
          src={heroBento}
          formats={['avif', 'webp']}
          alt="Chicken katsu bento box with rice, cabbage, potato salad and cucumber salad"
          widths={[420, 640, 900]}
          sizes="(max-width: 860px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          class="hero__bento"
        />
        <Image src={badge} alt="" width={180} height={180} class="hero__badge spin-slow" loading="eager" />
        <span class="sticker hero__sticker" style="--tilt: 8deg">Fried to order!</span>
      </div>
    </div>
  </section>

  <Marquee words={['Crispy', 'Juicy', 'Fried to order', 'Chicken', 'Pork', 'Tofu', 'Bay Area born']} />

  <KickstarterBlock />

  <!-- POP-UPS -->
  <section class="section" id="popups" aria-label="Pop-ups">
    <div class="wrap">
      <PopupsBlock />
      <div class="strip">
        {
          strip.map((s) => (
            <figure class="polaroid" style={`--tilt:${s.tilt}deg`}>
              <Image src={eventImage(s.img)} alt={s.cap} widths={[360, 560]} sizes="(max-width: 720px) 80vw, 340px" />
              <figcaption>{s.cap}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MENU HIGHLIGHTS -->
  <section class="section menu-hl" aria-labelledby="menu-hl-title">
    <div class="wrap">
      <div class="menu-hl__head">
        <span class="eyebrow">The menu</span>
        <h2 id="menu-hl-title">Pick your katsu.<br /><span class="hl">Make it yours.</span></h2>
        <ol class="steps">
          <li><strong>1</strong> Chicken, pork, or tofu</li>
          <li><strong>2</strong> Bento, curry, sando, or burger</li>
          <li><strong>3</strong> Pile on the sides</li>
        </ol>
      </div>
      <div class="menu-hl__grid">
        {highlights.map((item, i) => <Dish item={item} tilt={i % 2 ? 3 : -3} compact />)}
      </div>
      <p class="center"><a class="btn" href={url('menu')}>See the full menu</a></p>
    </div>
  </section>

  <!-- CATERING -->
  <section class="section on-red noren-top catering-hl" style="--noren: var(--ink)" aria-labelledby="cat-title">
    <div class="wrap catering-hl__in">
      <div>
        <span class="eyebrow">Catering</span>
        <h2 id="cat-title">We cater the whole Bay Area.</h2>
        <p>
          Office lunches, birthdays, school fundraisers, brewery takeovers. We'll deliver trays of bento, or roll up
          with the whole booth and fry everything fresh on site.
        </p>
        <p class="catering-hl__call">{site.phone ? 'Call us for a quote.' : 'Reach out for a quote.'}</p>
        <ContactLinks subject="Catering inquiry" />
        <p class="catering-hl__more"><a href={url('catering')}>How catering works →</a></p>
      </div>
      <figure class="polaroid" style="--tilt: 3deg">
        <Image
          src={eventImage('tent-night')}
          alt="Kingpin Katsu frying at an evening pop-up"
          widths={[420, 640]}
          sizes="(max-width: 860px) 90vw, 460px"
        />
        <figcaption>We bring the fryers.</figcaption>
      </figure>
    </div>
  </section>

  <!-- STORY -->
  <section class="section on-cream panko story-hl" aria-labelledby="story-title">
    <div class="wrap story-hl__in">
      <figure class="polaroid" style="--tilt: -3deg">
        <Image
          src={teamSelfie}
          alt="The Kingpin Katsu family and crew smiling at the booth"
          widths={[420, 640]}
          sizes="(max-width: 860px) 90vw, 460px"
        />
        <figcaption>The Kingpin crew</figcaption>
      </figure>
      <div>
        <span class="eyebrow">Our story</span>
        <h2 id="story-title">Family-run.<br />Katsu-obsessed.</h2>
        <p>
          We fell for katsu on a trip across Asia, studied it in Japan, and came home to the Bay to do it right: cutlets
          dry-brined overnight, crusted in Japanese panko, and sides made by hand every day.
        </p>
        <a class="btn btn--red" href={url('about')}>Read our story</a>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="section ig" aria-labelledby="ig-title">
    <div class="wrap">
      <div class="ig__head">
        <h2 id="ig-title">Follow the fryer</h2>
        <a class="btn btn--cream" href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle} ↗</a>
      </div>
      <div class="ig__grid">
        {
          igSquares.map((s) => (
            <a href={site.instagram.url} target="_blank" rel="noopener" class="ig__sq">
              <Image src={eventImage(s.img)} alt={s.alt} widths={[240, 420]} sizes="(max-width: 720px) 45vw, 270px" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    overflow: hidden;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }
  .hero__boss {
    color: var(--orange);
    display: inline-block;
    position: relative;
    isolation: isolate;
  }
  .hero__boss::after {
    content: '';
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 0.02em;
    height: 0.22em;
    background: var(--red-hot);
    z-index: -1;
    border-radius: 999px;
    transform: rotate(-2deg);
  }
  .hero__lede {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    max-width: 34ch;
    margin-bottom: 1.8rem;
    opacity: 0.92;
  }
  .hero__art {
    position: relative;
  }
  .hero__bento {
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }
  .hero__art :global(img.hero__bento),
  .hero__art :global(picture img) {
    width: 100%;
  }
  .hero__badge {
    position: absolute;
    width: clamp(96px, 16vw, 170px);
    height: auto;
    top: -2%;
    left: -4%;
    filter: drop-shadow(5px 5px 0 var(--orange));
  }
  .hero__sticker {
    position: absolute;
    right: 2%;
    bottom: 8%;
    font-size: clamp(1rem, 2vw, 1.3rem);
    background: var(--orange);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .menu-hl__head {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 2px solid rgb(255 244 224 / 0.35);
    border-radius: 999px;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    font-weight: 600;
  }
  .steps strong {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--orange);
    color: var(--ink);
    font: 400 1rem/1 var(--display);
  }
  .menu-hl__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .center {
    text-align: center;
  }

  .catering-hl {
    padding-top: clamp(4.5rem, 10vw, 7.5rem);
  }
  .catering-hl__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .catering-hl__call {
    font: 400 1.25rem/1.3 var(--display);
    color: var(--orange);
  }
  .catering-hl__more {
    margin-top: 1.4rem;
  }
  .catering-hl__more a {
    font-weight: 600;
  }

  .story-hl__in {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .story-hl .polaroid {
    box-shadow: 8px 8px 0 var(--red);
  }

  .ig__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .ig__head h2 {
    margin: 0;
  }
  .ig__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .ig__sq {
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid rgb(255 244 224 / 0.15);
    transition: transform 0.2s;
  }
  .ig__sq:hover {
    transform: scale(1.03) rotate(-1deg);
  }
  .ig__sq img {
    aspect-ratio: 1;
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 860px) {
    .hero__in,
    .catering-hl__in,
    .story-hl__in {
      grid-template-columns: 1fr;
    }
    .hero__in {
      gap: 1rem;
      padding-top: 1.25rem;
    }
    .hero__art {
      order: -1;
      width: min(68vw, 400px);
      margin-inline: auto;
    }
    .menu-hl__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .strip {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1.25rem;
      padding: 1rem 1.25rem 1.5rem;
      margin-inline: -1.25rem;
      scrollbar-width: none;
    }
    .strip .polaroid {
      flex: 0 0 72%;
      scroll-snap-align: center;
    }
    .ig__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
