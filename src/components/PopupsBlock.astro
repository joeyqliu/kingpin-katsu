---
import { Image } from 'astro:assets';
import catHead from '../assets/brand/cat-head.png';
import { site, popups } from '../lib/data';
import { upcomingPopups, formatPopupDate } from '../lib/time';

interface Props {
  heading?: 'h1' | 'h2';
}
const { heading = 'h2' } = Astro.props;
const H = heading;
const upcoming = upcomingPopups(popups, new Date());
---

<div class="pop">
  <div class="pop__sign sway" aria-hidden="true">
    <span>Next pop-up</span>
  </div>

  {
    upcoming.length === 0 ? (
      <div class="pop__empty">
        <Image src={catHead} alt="" width={140} height={140} class="pop__cat bob" />
        <H class="pop__title">Pop-ups coming up!</H>
        <p>
          We're lining up our next night markets, breweries, and block parties. Dates and locations drop on Instagram
          first, so follow along and don't miss the fryer.
        </p>
        <a class="btn" href={site.instagram.url} target="_blank" rel="noopener">
          Follow {site.instagram.handle} ↗
        </a>
      </div>
    ) : (
      <div>
        <H class="pop__title">Catch us here</H>
        <ul class="pop__list">
          {upcoming.map((p) => (
            <li class="pop__item">
              <div class="pop__date">
                <span>{formatPopupDate(p.date).split(', ')[0]}</span>
                <strong>{formatPopupDate(p.date).split(', ')[1]}</strong>
              </div>
              <div class="pop__info">
                <h3>{p.name}</h3>
                <p>
                  {p.venue}
                  {p.address && <>, {p.address}</>}
                  {(p.start || p.end) && (
                    <>
                      <br />
                      {[p.start, p.end].filter(Boolean).join(' to ')}
                    </>
                  )}
                </p>
                {p.note && <p class="pop__note">{p.note}</p>}
              </div>
              <div class="pop__links">
                {p.mapUrl && (
                  <a class="btn btn--sm btn--cream" href={p.mapUrl} target="_blank" rel="noopener">
                    Map
                  </a>
                )}
                {p.link && (
                  <a class="btn btn--sm" href={p.link} target="_blank" rel="noopener">
                    Details
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <p class="pop__more">
          More dates drop on{' '}
          <a href={site.instagram.url} target="_blank" rel="noopener">
            Instagram {site.instagram.handle}
          </a>
          .
        </p>
      </div>
    )
  }
</div>

<style>
  .pop {
    position: relative;
    background: linear-gradient(180deg, var(--wood) 0%, var(--wood-dark) 100%);
    border: 4px solid var(--ink);
    border-radius: 28px;
    padding: 3.25rem clamp(1.25rem, 4vw, 3rem) 2.25rem;
    box-shadow: 8px 8px 0 var(--ink);
    color: var(--cream);
    background-image:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.06) 0 2px, transparent 2px 46px),
      linear-gradient(180deg, var(--wood) 0%, var(--wood-dark) 100%);
  }
  .pop__sign {
    position: absolute;
    top: -26px;
    left: 50%;
    margin-left: -110px;
    width: 220px;
    text-align: center;
  }
  .pop__sign span {
    display: inline-block;
    background: var(--red-hot);
    color: var(--cream);
    font: 400 1.05rem/1 var(--display);
    padding: 0.75rem 1.25rem;
    border: 3px solid var(--ink);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .pop__title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    text-shadow: 3px 3px 0 var(--ink);
  }
  .pop__empty {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .pop__cat {
    width: 120px;
    height: 120px;
    margin-bottom: 0.5rem;
    filter: drop-shadow(4px 4px 0 var(--ink));
  }
  .pop__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .pop__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 18px;
    padding: 1rem 1.25rem;
  }
  .pop__date {
    display: grid;
    text-align: center;
    background: var(--red-hot);
    color: var(--cream);
    border-radius: 12px;
    padding: 0.5rem 0.8rem;
    min-width: 5.5rem;
    font-family: var(--display);
  }
  .pop__date strong {
    font-weight: 400;
    font-size: 1.15rem;
  }
  .pop__info h3 {
    margin-bottom: 0.2rem;
  }
  .pop__info p {
    margin: 0;
  }
  .pop__note {
    color: var(--red);
    font-weight: 600;
  }
  .pop__links {
    display: flex;
    gap: 0.5rem;
  }
  .pop__more {
    margin: 1.25rem 0 0;
    text-align: center;
  }
  @media (max-width: 640px) {
    .pop__item {
      grid-template-columns: auto 1fr;
    }
    .pop__links {
      grid-column: 1 / -1;
    }
  }
</style>
