---
import { Image } from 'astro:assets';
import badge from '../assets/brand/badge.png';
import { site } from '../lib/data';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="ftr noren-top" style="--noren: var(--ink)">
  <div class="wrap ftr__in">
    <div class="ftr__brand">
      <Image src={badge} alt="Kingpin Katsu: fresh, made-to-order katsu" width={150} height={150} class="spin-slow" />
      <p class="ftr__tag">Fresh katsu, made the way you choose.</p>
    </div>

    <nav class="ftr__col" aria-label="Footer">
      <h2>Explore</h2>
      <a href={url('menu')}>Menu</a>
      <a href={url('popups')}>Pop-ups</a>
      <a href={url('catering')}>Catering</a>
      <a href={url('about')}>About us</a>
      <a href={site.kickstarter.url} target="_blank" rel="noopener">Kickstarter ↗</a>
    </nav>

    <div class="ftr__col">
      <h2>Say hi</h2>
      <a href={site.instagram.url} target="_blank" rel="noopener">Instagram {site.instagram.handle}</a>
      <a href={site.facebook.url} target="_blank" rel="noopener">Facebook</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>}
      <p class="ftr__where">Popping up around the Bay Area.<br />Restaurant coming soon.</p>
    </div>
  </div>
  <p class="wrap ftr__fine">© {year} {site.name} · Inspired by Asia, born in the Bay Area.</p>
</footer>

<style>
  .ftr {
    background: var(--red);
    padding-top: 4.5rem;
  }
  .ftr__in {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .ftr__brand img {
    width: 130px;
    height: 130px;
  }
  .ftr__tag {
    font: 400 1.15rem/1.3 var(--display);
    margin-top: 1rem;
    max-width: 18ch;
  }
  .ftr__col {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .ftr__col h2 {
    font-size: 1.1rem;
    color: var(--orange);
    margin-bottom: 0.4rem;
  }
  .ftr__col a {
    text-decoration: none;
    width: fit-content;
  }
  .ftr__col a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-underline-offset: 4px;
  }
  .ftr__where {
    margin-top: 0.8rem;
    opacity: 0.8;
    font-size: 0.95rem;
  }
  .ftr__fine {
    border-top: 1px solid rgb(255 244 224 / 0.2);
    padding-block: 1.25rem;
    margin-block: 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  @media (max-width: 720px) {
    .ftr__in {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .ftr__brand img {
      width: 96px;
      height: 96px;
    }
    .ftr__tag {
      margin: 0;
    }
  }
</style>
