---
import { site, popups } from '../lib/data';
import { upcomingPopups } from '../lib/time';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | Fresh katsu, made to order` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.jpg'), Astro.site).href;
const home = new URL(url(), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: site.name,
  url: home,
  image: ogImage,
  logo: new URL(url('apple-touch-icon.png'), Astro.site).href,
  servesCuisine: 'Japanese',
  description: 'Crispy, juicy Japanese katsu made fresh to order. Pop-ups and catering across the Bay Area.',
  areaServed: 'San Francisco Bay Area',
  email: site.email,
  ...(site.phone ? { telephone: site.phone } : {}),
  sameAs: [site.instagram.url, site.facebook.url],
  event: upcomingPopups(popups, new Date()).map((p) => ({
    '@type': 'FoodEvent',
    name: `${site.name} pop-up: ${p.name}`,
    startDate: p.date,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: p.venue, ...(p.address ? { address: p.address } : {}) },
  })),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
